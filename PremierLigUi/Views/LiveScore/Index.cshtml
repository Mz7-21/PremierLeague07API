@model PremierLigUi.Models.DashboardViewModel

@{
    Layout = null;

    var liveMatches = Model?.LiveMatches ?? new List<DTOLayer.DashboardDtos.DashboardLatestMatchDto>();
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <title>GoalZone | Canlı Maçlar</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />

    <style>
            @@import url('https://fonts.googleapis.com/css2?family=Rajdhani:wght@500;600;700;800&display=swap');

            :root {
                --bg: #070d18;
                --card: #101827;
                --line: #1b2b46;
                --blue: #2979ff;
                --green: #00e676;
                --red: #ff2d55;
                --text: #eef4ff;
                --muted: #7f96bd;
            }

            * {
                box-sizing: border-box;
            }

            body {
                margin: 0;
                background: var(--bg);
                color: var(--text);
                font-family: 'Rajdhani', sans-serif;
            }

            a {
                color: inherit;
                text-decoration: none;
            }

            .topbar {
                height: 74px;
                border-bottom: 1px solid var(--line);
                background: #08101f;
                display: flex;
                align-items: center;
            }

            .wrap {
                width: min(1100px, calc(100% - 34px));
                margin: 0 auto;
            }

            .nav-inner {
                display: flex;
                align-items: center;
                justify-content: space-between;
            }

            .brand {
                display: flex;
                align-items: center;
                gap: 14px;
                color: var(--text);
            }

            .premier-brand {
                justify-content: center;
            }

            .premier-logo {
                width: 52px;
                height: 52px;
                object-fit: contain;
                filter: drop-shadow(0 0 14px rgba(41,121,255,.25));
            }

            .premier-text {
                display: flex;
                flex-direction: column;
                line-height: 1;
            }

            .premier-title {
                font-size: 27px;
                font-weight: 900;
                letter-spacing: .5px;
            }

            .premier-season {
                margin-top: 6px;
                font-size: 13px;
                color: var(--muted);
                font-weight: 800;
                letter-spacing: 1.4px;
            }

            .nav {
                display: flex;
                align-items: center;
                gap: 34px;
                color: var(--muted);
                font-size: 14px;
                font-weight: 800;
                letter-spacing: 2px;
            }

                .nav a {
                    padding: 27px 0;
                    position: relative;
                }

                    .nav a.active,
                    .nav a:hover {
                        color: var(--text);
                    }

                        .nav a.active::after {
                            content: "";
                            position: absolute;
                            left: 0;
                            bottom: 0;
                            width: 100%;
                            height: 3px;
                            background: var(--green);
                            border-radius: 99px;
                        }

            .page {
                padding: 38px 0;
            }

            .page-head {
                margin-bottom: 22px;
            }

                .page-head h1 {
                    margin: 0;
                    font-size: 38px;
                    font-weight: 900;
                }

                .page-head p {
                    margin: 6px 0 0;
                    color: var(--muted);
                    font-size: 17px;
                }

            .live-count {
                display: inline-flex;
                align-items: center;
                gap: 8px;
                margin-top: 16px;
                background: rgba(255,45,85,.12);
                color: var(--red);
                border: 1px solid rgba(255,45,85,.28);
                padding: 8px 13px;
                border-radius: 999px;
                font-weight: 900;
            }

            .pulse {
                width: 9px;
                height: 9px;
                background: var(--red);
                border-radius: 50%;
                box-shadow: 0 0 0 rgba(255,45,85,.6);
                animation: pulse 1.4s infinite;
            }

            @@keyframes pulse {
                0% {
                    box-shadow: 0 0 0 0 rgba(255,45,85,.6);
                }

                70% {
                    box-shadow: 0 0 0 10px rgba(255,45,85,0);
                }

                100% {
                    box-shadow: 0 0 0 0 rgba(255,45,85,0);
                }
            }

            .live-list {
                display: grid;
                gap: 14px;
            }

            .live-card {
                background: var(--card);
                border: 1px solid rgba(255,45,85,.35);
                border-radius: 20px;
                padding: 18px;
                display: grid;
                grid-template-columns: 90px 1fr auto;
                align-items: center;
                gap: 18px;
            }

            .live-minute {
                text-align: center;
                color: var(--red);
                font-size: 22px;
                font-weight: 900;
            }

            .live-badge {
                display: inline-flex;
                align-items: center;
                gap: 6px;
                margin-top: 6px;
                padding: 5px 10px;
                border-radius: 999px;
                background: rgba(255,45,85,.14);
                color: var(--red);
                font-size: 12px;
                font-weight: 900;
            }

            .teams {
                display: grid;
                gap: 10px;
            }

            .team-row {
                display: grid;
                grid-template-columns: 42px 1fr 40px;
                align-items: center;
                gap: 12px;
                border-bottom: 1px solid rgba(255,255,255,.04);
                padding-bottom: 8px;
            }

                .team-row:last-child {
                    border-bottom: none;
                    padding-bottom: 0;
                }

                .team-row img {
                    width: 34px;
                    height: 34px;
                    object-fit: contain;
                    background: #142039;
                    border-radius: 50%;
                    padding: 5px;
                }

            .team-name {
                font-size: 21px;
                font-weight: 900;
            }

            .score {
                text-align: right;
                font-size: 28px;
                font-weight: 900;
                color: #fff;
            }

            .detail-btn {
                border: 1px solid rgba(41,121,255,.45);
                color: var(--blue);
                background: rgba(41,121,255,.10);
                padding: 10px 14px;
                border-radius: 12px;
                font-weight: 900;
                letter-spacing: 1px;
            }

            .empty {
                background: var(--card);
                border: 1px solid var(--line);
                border-radius: 20px;
                padding: 28px;
                color: var(--muted);
                font-size: 18px;
            }

            @@media (max-width: 800px) {
                .nav {
                    display: none;
                }

                .live-card {
                    grid-template-columns: 1fr;
                }

                .live-minute {
                    text-align: left;
                }

                .detail-btn {
                    text-align: center;
                }
            }
    </style>
</head>

<body>
    <header class="topbar">
        <div class="wrap nav-inner">
            <a href="/" class="brand premier-brand">
                <img src="/images/premier-league-logo.png"
                     alt="Premier League"
                     class="premier-logo" />

                <div class="premier-text">
                    <div class="premier-title">Premier League</div>
                    <div class="premier-season">2007/08 Sezonu</div>
                </div>
            </a>

            <nav class="nav">
                <a href="/Dashboard/Index" class="active">ANA SAYFA</a>
                <a href="/LiveScore/Index">CANLI SKORLAR</a>
                <a href="/Fixture/Index">FİKSTÜR</a>
                <a href="/Standing/Index">PUAN DURUMU</a>
            </nav>
        </div>
    </header>

    <main class="wrap page">
        <div class="page-head">
            <h1>Canlı Maçlar</h1>
            <p>Premier League 2007/08 sezonunda şu anda oynanan maçlar.</p>

            <div class="live-count">
                <span class="pulse"></span>
                @liveMatches.Count canlı maç
            </div>
        </div>

        @if (!liveMatches.Any())
        {
            <div class="empty">
                Şu anda canlı maç bulunmuyor.
            </div>
        }
        else
        {
            <div class="live-list">
                @foreach (var item in liveMatches)
                {
                    <div class="live-card">
                        <div class="live-minute">
                            LIVE
                            <div class="live-badge">
                                <span class="pulse"></span>
                                CANLI
                            </div>
                        </div>

                        <div class="teams">
                            <div class="team-row">
                                <img src="@item.HomeTeamLogoUrl" onerror="this.style.display='none'" />
                                <div class="team-name">@item.HomeTeam</div>
                                <div class="score">@item.HomeScore</div>
                            </div>

                            <div class="team-row">
                                <img src="@item.AwayTeamLogoUrl" onerror="this.style.display='none'" />
                                <div class="team-name">@item.AwayTeam</div>
                                <div class="score">@item.AwayScore</div>
                            </div>
                        </div>

                        <a href="/MatchDetail/Detail/@item.MatchId" class="detail-btn">
                            DETAY <i class="bi bi-arrow-right"></i>
                        </a>
                    </div>
                }
            </div>
        }
    </main>
</body>
</html>