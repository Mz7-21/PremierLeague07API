@model List<PremierLigUi.Models.AdminMatchViewModel>

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";

    var teams = ViewBag.Teams as List<PremierLigUi.Models.AdminTeamViewModel>;
    var weeks = Model!
        .Select(x => x.Week)
        .Distinct()
        .OrderBy(x => x)
        .ToList();
}

<style>
    .match-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 18px;
        gap: 14px;
        flex-wrap: wrap;
    }

    .match-title h5 {
        margin: 0;
        font-weight: 800;
    }

    .match-title small {
        color: #7b96c4;
    }

    .match-filter {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    .admin-select {
        background: #0c1220;
        border: 1px solid #1a2640;
        color: #eef2ff;
        border-radius: 8px;
        padding: 7px 10px;
        font-size: 13px;
    }

    .match-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(380px, 1fr));
        gap: 16px;
    }

    .match-card {
        background: #111827;
        border: 1px solid #1a2640;
        border-radius: 16px;
        padding: 16px;
        transition: .2s;
    }

        .match-card:hover {
            transform: translateY(-3px);
            border-color: #2979ff;
            background: #16202f;
        }

    .match-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 14px;
        gap: 10px;
    }

    .match-meta {
        color: #7b96c4;
        font-size: 12px;
        font-weight: 600;
    }

    .team-line {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        gap: 12px;
        margin: 14px 0;
    }

    .team-side {
        display: flex;
        align-items: center;
        gap: 10px;
        min-width: 0;
    }

        .team-side.home {
            justify-content: flex-end;
            text-align: right;
        }

        .team-side.away {
            justify-content: flex-start;
        }

    .team-logo {
        width: 38px;
        height: 38px;
        border-radius: 50%;
        background: #1c2d42;
        border: 1px solid #263855;
        overflow: hidden;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 10px;
        font-weight: 800;
    }

        .team-logo img {
            width: 100%;
            height: 100%;
            object-fit: contain;
            padding: 5px;
        }

    .team-name {
        font-weight: 800;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .score-box {
        background: #0c1220;
        border: 1px solid #1a2640;
        border-radius: 12px;
        padding: 8px 12px;
        font-size: 20px;
        font-weight: 900;
        color: #eef2ff;
        min-width: 76px;
        text-align: center;
    }

    .match-info {
        border-top: 1px solid #1a2640;
        padding-top: 12px;
        margin-top: 12px;
        color: #7b96c4;
        font-size: 13px;
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .match-actions {
        display: flex;
        gap: 8px;
        margin-top: 14px;
    }

        .match-actions a,
        .match-actions button {
            flex: 1;
        }

    .badge-live {
        background: #ff1744;
    }

    .badge-finished {
        background: #00b894;
    }

    .badge-waiting {
        background: #6c757d;
    }

    .admin-modal {
        background: #111827;
        color: #eef2ff;
        border: 1px solid #1a2640;
        border-radius: 16px;
    }

        .admin-modal .modal-header,
        .admin-modal .modal-footer {
            border-color: #1a2640;
        }

        .admin-modal label {
            color: #7b96c4;
            font-size: 13px;
            margin-bottom: 6px;
        }

    .admin-input {
        background: #0c1220;
        border: 1px solid #1a2640;
        color: #eef2ff;
    }

        .admin-input:focus {
            background: #0c1220;
            border-color: #2979ff;
            color: #eef2ff;
            box-shadow: none;
        }
</style>

<div class="match-head">
    <div class="match-title">
        <h5>Maçlar</h5>
        <small>Premier League 2007/08 maç listesi · @(Model?.Count ?? 0) maç</small>
    </div>

    <div class="match-filter">
        <select class="admin-select" id="weekFilter" onchange="filterMatches()">
            <option value="all">Tüm Haftalar</option>
            @foreach (var week in weeks)
            {
                <option value="@week">Hafta @week</option>
            }
        </select>

        <select class="admin-select" id="statusFilter" onchange="filterMatches()">
            <option value="all">Tüm Durumlar</option>
            <option value="2">Bitti</option>
            <option value="1">Canlı</option>
            <option value="0">Oynanmadı</option>
        </select>

        <button type="button" class="btn btn-success btn-sm" data-bs-toggle="modal" data-bs-target="#addMatchModal">
            <i class="bi bi-plus-circle"></i> Yeni Maç
        </button>
    </div>
</div>

<div class="match-grid">
    @foreach (var item in Model!)
    {
        var statusText = item.Status == 2 ? "Bitti" : item.Status == 1 ? "Canlı" : "Oynanmadı";
        var statusClass = item.Status == 2 ? "badge-finished" : item.Status == 1 ? "badge-live" : "badge-waiting";

        <div class="match-card" data-week="@item.Week" data-status="@item.Status">
            <div class="match-top">
                <div class="match-meta">
                    #@item.MatchId · Hafta @item.Week
                </div>

                <span class="badge @statusClass">@statusText</span>
            </div>

            <div class="team-line">
                <div class="team-side home">
                    <div class="team-name">@item.HomeTeam</div>
                    <div class="team-logo">
                        <img src="@item.HomeTeamLogoUrl"
                             alt="@item.HomeTeam"
                             onerror="this.parentNode.textContent='EV'" />
                    </div>
                </div>

                <div class="score-box">
                    @item.HomeScore - @item.AwayScore
                </div>

                <div class="team-side away">
                    <div class="team-logo">
                        <img src="@item.AwayTeamLogoUrl"
                             alt="@item.AwayTeam"
                             onerror="this.parentNode.textContent='DEP'" />
                    </div>
                    <div class="team-name">@item.AwayTeam</div>
                </div>
            </div>

            <div class="match-info">
                <div>
                    <i class="bi bi-calendar3"></i>
                    @item.MatchDate.ToString("dd.MM.yyyy HH:mm")
                </div>

                <div>
                    <i class="bi bi-geo-alt"></i>
                    @item.Stadium
                </div>
            </div>

            <div class="match-actions">
                <a href="/MatchDetail/Detail/@item.MatchId" target="_blank" class="btn btn-outline-info btn-sm">
                    <i class="bi bi-eye"></i> Detay
                </a>

                <button type="button"
                        class="btn btn-outline-primary btn-sm"
                        data-bs-toggle="modal"
                        data-bs-target="#editMatchModal"
                        onclick="fillEditMatchModal('@item.MatchId',
                    '@item.HomeTeamId',
                    '@item.AwayTeamId',
                    '@item.HomeScore',
                    '@item.AwayScore',
                    '@item.MatchDate.ToString("yyyy-MM-ddTHH:mm")',
                    '@item.Week',
                    '@item.Stadium',
                    '@item.Status')">
                    <i class="bi bi-pencil"></i> Düzenle
                </button>

                <button type="button"
                        class="btn btn-outline-danger btn-sm"
                        data-bs-toggle="modal"
                        data-bs-target="#deleteMatchModal"
                        onclick="fillDeleteMatchModal('@item.MatchId', '@item.HomeTeam', '@item.AwayTeam')">
                    <i class="bi bi-trash"></i> Sil
                </button>
            </div>
        </div>
    }
</div>

<!-- ADD MATCH MODAL -->
<div class="modal fade" id="addMatchModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content admin-modal">
            <form method="post" action="/Admin/Match/Create">
                <div class="modal-header">
                    <h5 class="modal-title">Yeni Maç Ekle</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label>Ev Sahibi TeamId</label>
                            <select name="HomeTeamId" class="form-control admin-input" required>
                                <option value="">Ev sahibi seç</option>
                                @foreach (var team in teams!)
                                {
                                    <option value="@team.TeamId">@team.Name</option>
                                }
                            </select>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label>Deplasman TeamId</label>
                            <select name="AwayTeamId" class="form-control admin-input" required>
                                <option value="">Deplasman seç</option>
                                @foreach (var team in teams!)
                                {
                                    <option value="@team.TeamId">@team.Name</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label>Ev Skor</label>
                            <input type="number" name="HomeScore" class="form-control admin-input" value="0" required />
                        </div>

                        <div class="col-md-6 mb-3">
                            <label>Deplasman Skor</label>
                            <input type="number" name="AwayScore" class="form-control admin-input" value="0" required />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label>Maç Tarihi</label>
                        <input type="datetime-local" name="MatchDate" class="form-control admin-input" required />
                    </div>

                    <div class="mb-3">
                        <label>Hafta</label>
                        <input type="number" name="Week" class="form-control admin-input" min="1" max="38" required />
                    </div>

                    <div class="mb-3">
                        <label>Stadyum</label>
                        <input type="text" name="Stadium" class="form-control admin-input" required />
                    </div>

                    <div class="mb-3">
                        <label>Durum</label>
                        <select name="Status" class="form-control admin-input">
                            <option value="0">Oynanmadı</option>
                            <option value="1">Canlı</option>
                            <option value="2">Bitti</option>
                        </select>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Vazgeç</button>
                    <button type="submit" class="btn btn-success btn-sm">Kaydet</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- EDIT MATCH MODAL -->
<div class="modal fade" id="editMatchModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content admin-modal">
            <form method="post" action="/Admin/Match/Update">
                <div class="modal-header">
                    <h5 class="modal-title">Maçı Düzenle</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">
                    <input type="hidden" name="MatchId" id="editMatchId" />

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label>Ev Sahibi TeamId</label>
                            <select name="HomeTeamId" id="editHomeTeamId" class="form-control admin-input" required>
                                @foreach (var team in teams!)
                                {
                                    <option value="@team.TeamId">@team.Name</option>
                                }
                            </select>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label>Deplasman TeamId</label>
                            <select name="AwayTeamId" id="editAwayTeamId" class="form-control admin-input" required>
                                @foreach (var team in teams!)
                                {
                                    <option value="@team.TeamId">@team.Name</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label>Ev Skor</label>
                            <input type="number" name="HomeScore" id="editHomeScore" class="form-control admin-input" required />
                        </div>

                        <div class="col-md-6 mb-3">
                            <label>Deplasman Skor</label>
                            <input type="number" name="AwayScore" id="editAwayScore" class="form-control admin-input" required />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label>Maç Tarihi</label>
                        <input type="datetime-local" name="MatchDate" id="editMatchDate" class="form-control admin-input" required />
                    </div>

                    <div class="mb-3">
                        <label>Hafta</label>
                        <input type="number" name="Week" id="editWeek" class="form-control admin-input" required />
                    </div>

                    <div class="mb-3">
                        <label>Stadyum</label>
                        <input type="text" name="Stadium" id="editStadium" class="form-control admin-input" required />
                    </div>

                    <div class="mb-3">
                        <label>Durum</label>
                        <select name="Status" id="editStatus" class="form-control admin-input">
                            <option value="0">Oynanmadı</option>
                            <option value="1">Canlı</option>
                            <option value="2">Bitti</option>
                        </select>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Vazgeç</button>
                    <button type="submit" class="btn btn-primary btn-sm">Güncelle</button>
                </div>
            </form>
        </div>
    </div>
</div>


<!-- DELETE MATCH MODAL -->
<div class="modal fade" id="deleteMatchModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content admin-modal">
            <form method="post" action="/Admin/Match/Delete">
                <div class="modal-header">
                    <h5 class="modal-title">Maçı Sil</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">
                    <input type="hidden" name="id" id="deleteMatchId" />

                    <p>
                        <strong id="deleteMatchName"></strong> maçını silmek istediğine emin misin?
                    </p>

                    <small style="color:#ff1744">
                        Bu maçın event ve istatistik kayıtları varsa silme işlemi hata verebilir.
                    </small>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Vazgeç</button>
                    <button type="submit" class="btn btn-danger btn-sm">Sil</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function filterMatches() {
        const selectedWeek = document.getElementById('weekFilter').value;
        const selectedStatus = document.getElementById('statusFilter').value;

        document.querySelectorAll('.match-card').forEach(card => {
            const week = card.getAttribute('data-week');
            const status = card.getAttribute('data-status');

            const weekOk = selectedWeek === 'all' || selectedWeek === week;
            const statusOk = selectedStatus === 'all' || selectedStatus === status;

            card.style.display = weekOk && statusOk ? 'block' : 'none';
        });
    }
     function fillEditMatchModal(matchId, homeTeamId, awayTeamId, homeScore, awayScore, matchDate, week, stadium, status) {
        document.getElementById('editMatchId').value = matchId;
        document.getElementById('editHomeTeamId').value = homeTeamId;
        document.getElementById('editAwayTeamId').value = awayTeamId;
        document.getElementById('editHomeScore').value = homeScore;
        document.getElementById('editAwayScore').value = awayScore;
        document.getElementById('editMatchDate').value = matchDate;
        document.getElementById('editWeek').value = week;
        document.getElementById('editStadium').value = stadium;
        document.getElementById('editStatus').value = status;
    }

    function fillDeleteMatchModal(matchId, homeTeam, awayTeam) {
        document.getElementById('deleteMatchId').value = matchId;
        document.getElementById('deleteMatchName').innerText = homeTeam + " - " + awayTeam;
    }
</script>